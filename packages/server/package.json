{
  "name": "@docstack/server",
  "version": "0.0.2",
  "main": "src/index.ts",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "test": "node --test \"test/**/*.spec.mjs\"",
    "start": "node ./lib/index.js",
    "build:types": "npx tsc -p ./tsconfig.json",
    "build": "rollup --config ./rollup.config.js && npm run build:types && cp -r ./src/utils/stack/datamodel/patch lib/",
    "develop": "ts-node -r tsconfig-paths/register ./index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onyx-og/docstack.git"
  },
  "keywords": [
    "server",
    "admin",
    "nosql",
    "workbench",
    "db"
  ],
  "author": "Onyx <hello@onyx.ac> (https://onyx.ac)",
  "license": "CC-BY-SA-4.0",
  "bugs": {
    "url": "https://github.com/onyx-og/docstack/issues"
  },
  "homepage": "https://onyx.ac/products/docstack",
  "description": "DocStack on a host: one engine, two surfaces (spec 03). Rewrite in progress; the old sources are not built.",
  "dependencies": {
    "@docstack/client": "^0.3.2",
    "pouchdb": "^9.0.0",
    "pouchdb-adapter-memory": "^9.0.0",
    "pouchdb-find": "^9.0.0"
  }
}
