{
  "name": "@docstack/server",
  "version": "0.1.0",
  "description": "DocStack on a host: one engine, two surfaces. An API surface under engine sessions for online clients, a Couch-compatible replication surface for replicas, the authority, jobs and the workbench.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "bin": {
    "docstack-server": "./bin/ds.js",
    "ds": "./bin/ds.js"
  },
  "files": [
    "lib",
    "bin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -build --force ./tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.spec.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onyx-og/docstack.git"
  },
  "keywords": [
    "docstack",
    "server",
    "pouchdb",
    "couchdb",
    "replication",
    "offline-first"
  ],
  "author": "Onyx <hello@onyx.ac> (https://onyx.ac)",
  "license": "CC-BY-SA-4.0",
  "bugs": {
    "url": "https://github.com/onyx-og/docstack/issues"
  },
  "homepage": "https://onyx.ac/products/docstack",
  "dependencies": {
    "@docstack/abe": "^0.1.1",
    "@docstack/client": "^0.3.2",
    "@docstack/shared": "^0.1.1",
    "jose": "^6.2.0",
    "pouchdb": "^9.0.0",
    "pouchdb-adapter-memory": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/pouchdb": "^6.4.2",
    "@types/pouchdb-adapter-memory": "^6.1.6",
    "typescript": "^5.7.3"
  }
}
