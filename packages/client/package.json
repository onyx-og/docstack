{
  "name": "@docstack/client",
  "version": "0.0.1",
  "main": "lib/index.js",
  "src": "src/index.ts",
  "type": "module",
  "scripts": {
    "build:types": "npx tsc -build --force ./tsconfig.json",
    "build": "rollup --config ./rollup.config.js && npm run build:types",
    "lint": "eslint ./src --ext .ts,.tsx",
    "test:node": "jest --config jest.config.ts",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "serve:test": "npx http-server dist -p 3000 -c-1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onyx-og/docstack.git"
  },
  "keywords": [
    "nosql",
    "db",
    "storage",
    "management"
  ],
  "author": "Onyx <hello@onyx.ac> (https://onyx.ac)",
  "license": "CC-BY-SA-4.0",
  "bugs": {
    "url": "https://github.com/onyx-og/docstack/issues"
  },
  "homepage": "https://github.com/onyx-og/docstack#readme",
  "description": "",
  "dependencies": {
    "@docstack/shared": "file:../shared",
    "pouchdb-adapter-node-websql": "^7.0.0",
    "pouchdb-adapter-websql": "^7.0.0",
    "pouchdb-browser": "^9.0.0",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/semver": "^7.7.1",
    "cpy-cli": "^6.0.0",
    "eslint": "^9.38.0",
    "eslint-webpack-plugin": "^5.0.2",
    "http-server": "^14.1.1",
    "rollup": "^4.53.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "*"
  }
}
