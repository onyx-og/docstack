{
  "name": "@docstack/client",
  "description": "One does not simply stack documents.",
  "version": "0.1.5",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js"
  },
  "src": "src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "types": "lib/index.d.ts",
  "type": "module",
  "files": [
    "lib"
  ],
  "scripts": {
    "build:types": "npx tsc -build --force ./tsconfig.json",
    "build": "rollup --config ./rollup.config.js",
    "build:dev": "webpack --node-env=development",
    "build:prod": "webpack --node-env=production",
    "build:vendor": "rollup --config ./rollup.vendor.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint ./src --ext .ts,.tsx",
    "test": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onyx-og/docstack.git"
  },
  "keywords": [
    "nosql",
    "db",
    "storage",
    "management"
  ],
  "author": "Onyx <hello@onyx.ac> (https://onyx.ac)",
  "license": "CC-BY-SA-4.0",
  "bugs": {
    "url": "https://github.com/onyx-og/docstack/issues"
  },
  "homepage": "https://onyx.ac/docstack",
  "dependencies": {
    "@docstack/shared": "^0.0.6",
    "jsondiffpatch": "^0.6.0",
    "pouchdb-browser": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "semver": "^7.7.3",
    "jsondiffpatch": "^0.7.3",
    "winston": "^3.13.0",
    "winston-transport": "^4.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rollup/rollup-linux-x64-gnu": "^4.57.1",
    "@types/semver": "^7.7.1",
    "http-server": "^14.1.1",
    "is-reference": "^1.2.1",
    "rollup": "^4.53.1",
    "rollup-plugin-polyfill-node": "^0.13.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "*"
