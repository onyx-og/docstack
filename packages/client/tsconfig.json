{
  "compilerOptions": {
    "sourceMap": true,
    "target": "es2017",
    "allowJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "lib",
    "rootDir": "src",
    "declarationDir": "lib",
    "baseUrl": "./src",
    "skipLibCheck": true,
    "strict": false,
    "alwaysStrict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "declaration": true,
    // Types only: rollup owns every .js in `lib`, tsc owns every .d.ts. They share an
    // output directory, so without this both write `lib/index.js` and whichever ran last
    // wins - and `tsc -build` reaches this project through the `references` in
    // packages/react, so building a *sibling* would silently replace the bundle with a
    // re-export stub that points at files rollup does not emit. `@docstack/server` does
    // the same thing for the same reason.
    "emitDeclarationOnly": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "composite": true,
    "paths": {
      "@docstack/shared": [
        "../../shared"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js"
  ],
  "exclude": [
    "lib",
    "node_modules",
    "**/*.test.ts",
    "e2e",
    "src/fixtures.ts"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ]
}