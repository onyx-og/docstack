# Publishing the documentation to onyx.ac with pterodoc.
# Copy to .env and fill in. The .env file is git-ignored; never commit credentials.
#
# Only credentials and per-machine overrides live here. Where the documentation
# is published, and how it is laid out, is in pterodoc.config.mjs.

# The WordPress site. No trailing slash.
WP_URL=https://onyx.ac

# A WordPress user and one of its Application Passwords
# (Users -> Profile -> Application Passwords). The spaces WordPress shows are
# optional; they are stripped before use.
WP_USER=
WP_APP_PASSWORD=

# Optional overrides.
# PTERODOC_WP_ROOT=/products/docstack   # Move the documentation without editing the config.
# PTERODOC_WP_STATUS=draft              # Publish as drafts while reviewing.
# WP_LANG=en                            # Polylang language code.
# WP_METHOD_OVERRIDE=1                  # If the host blocks HTTP DELETE.
